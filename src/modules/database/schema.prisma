// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
}

enum UserRole {
  USER
  ADMIN
}

enum GoalType {
  WEEKLY_COUNT
  ABSTINENCE
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      UserRole @default(USER)
  gender    Gender
  birthDate DateTime
  
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  profile      UserProfile?
  masturbationWeeks MasturbationWeek[]
  masturbationRecords DailyMasturbationRecord[]
  masturbationGoals MasturbationGoal[]

  @@map("user")
}

model UserProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  height    Float?   // cm
  weight    Float?   // kg
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_profiles")
}

model MasturbationWeek {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  count        Int      @default(0) // 해당 주 자위 횟수
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("masturbation_weeks")
}

model DailyMasturbationRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date      DateTime
  count     Int      @default(1)
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
  @@map("daily_masturbation_records")
}

model MasturbationGoal {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type                  GoalType
  weeklyTargetCount     Int?
  abstinenceTargetDays  Int?
  startDate             DateTime
  endDate               DateTime?
  isActive              Boolean  @default(true)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId, isActive])
  @@map("masturbation_goals")
}
